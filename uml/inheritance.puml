@startuml
class Product {
- id : int
- name : String
- qty : int
- inStock : boolean
- price : double
+ calculateTotal() : double
+ getName() : String
+ getPrice() : double

}
class DigitalProduct {
- downloadUrl : String
- fileSizeMB : double
+ getDownloadUrl() : String
+ getFileSizeMB() : double
}
class PhysicalProduct {
- weightKg : double
- dimensions : String

+ getWeightKg() : double
+ getDimensions() : String
}
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml